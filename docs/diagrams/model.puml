@startuml model
package io.github.iss_2025_2026.model {

    abstract class Character {
        - name: String
        - hp: int
        - maxHp: int
        - baseDamage: int
        # level: int
        - x: float
        - y: float
        - speed: float
        - direction: Direction
        - state: CharacterState
        - stateTime: float
        - attackDuration: float
        + Character(name: String, maxHp: int, baseDamage: int, level: int)
        + takeDamage(amount: int): void
        + heal(amount: int): void
        + increaseBaseDamageByPercent(percentage: int): void
        + isAlive(): boolean
        + copyRuntimeStateTo(copy: Character): void
    }

    class Player {
        - characterId: String
        - karma: int
        - backpack: Backpack
        - ability: SpecialAbility
        - maxHpGrowth: int
        - damageGrowth: int
        - specialAbilityUsedThisBattle: boolean
        + Player(name: String, maxHp: int, baseDamage: int, ability: SpecialAbility)
        + modifyKarma(variation: int): void
        + useSpecialAbility(target: Character): void
        + hasUsedSpecialAbilityThisBattle(): boolean
        + markSpecialAbilityUsed(): void
        + resetSpecialAbilityUsageForBattle(): void
        + levelUp(): void
        + restoreState(...)
    }

    class Enemy {
        - enemyId: String
        - xpReward: int
        - isBoss: boolean
        - specialAbility: SpecialAbility
        + Enemy(name: String, enemyId: String, maxHp: int, baseDamage: int, xpReward: int, isBoss: boolean)
        + hasSpecialAbility(): boolean
        + copy(): Enemy
    }

    interface CharacterPrototype<T> {
        + copy(): T
    }

    class Backpack {
        - capacity: int
        - items: List<Collectible>
        + Backpack(capacity: int)
        + addItem(item: Collectible): boolean
        + removeItem(item: Collectible): boolean
        + getItems(): List<Collectible>
    }

    class Collectible {
        - id: String
        - name: String
        - description: String
        - effectStrategy: CollectibleEffectStrategy
        + use(context: CollectibleUseContext): void
    }

    interface SpecialAbility {
        + getName(): String
        + getDescription(): String
        + perform(source: Character, target: Character, level: int): void
    }

    class GameModel {
        - gameState: GameState
        - message: String
        - timer: float
        - gameName: String
        - gameMode: GameMode
        - playerOne: Player
        - playerTwo: Player
        - gameStarted: boolean
        - currentSaveFileName: String
        - activeBattleModel: BattleModel
        + GameModel()
        + update(delta: float): void
        + startSinglePlayerGame(gameName: String, player: Player): void
        + startMultiplayerGame(gameName: String, p1: Player, p2: Player): void
    }

    class GameState {
        - schemaVersion: int
        - saveType: SaveType
        - gameName: String
        - gameMode: GameMode
        - playerOne: PlayerSaveState
        - playerTwo: PlayerSaveState
        - savedAt: String
        - currentLevelId: int
        - phase: Phase
        - completedLevelIds: List<Integer>
        - lastCheckpointLevelId: int
        + GameState()
        + addCompletedLevelId(levelId: int): void
    }

    class PlayerSaveState {
        - characterId: String
        - name: String
        - hp: int
        - maxHp: int
        - baseDamage: int
        - level: int
        - karma: int
        - backpack: Backpack
        - x: float
        - y: float
        - direction: Direction
        - state: CharacterState
        + PlayerSaveState()
        + PlayerSaveState(characterId: String, name: String, hp: int, maxHp: int, baseDamage: int, level: int, karma: int, backpack: Backpack)
    }

    class CharacterSelectionModel {
        - characters: List<CharacterSelectionOption>
        - selectedIndex: int
        + CharacterSelectionModel(factory: CharacterFactory)
        + getSelectedCharacter(): CharacterSelectionOption
        + nextCharacter(): void
        + previousCharacter(): void
    }

    class CharacterSelectionOption {
        - id: String
        - name: String
        - description: String
        - maxHp: int
        - baseDamage: int
        - maxHpGrowth: int
        - damageGrowth: int
        - abilityName: String
        - abilityDescription: String
        - traits: List<String>
        + CharacterSelectionOption(...)
    }

    class GameSettings {
        - masterVolume: float
        - musicVolume: float
        - sfxVolume: float
        - keyBindings: Map<String, String>
        + GameSettings()
    }

    class SettingsMenuModel {
        - masterVolume: float
        - musicVolume: float
        - sfxVolume: float
        - keyBindings: Map<String, String>
        + SettingsMenuModel()
        + toGameSettings(): GameSettings
        + loadFrom(gs: GameSettings): void
    }

    class MainMenuModel {
        + getAvailableActions(isRunning: boolean): MenuAction[]
    }

    class NewGameConfigModel {
        - gameName: String
        - gameMode: GameMode
        - selectedCharacterPlayerOne: String
        - selectedCharacterPlayerTwo: String
        + NewGameConfigModel()
        + isMultiplayer(): boolean
    }

    enum Direction {
        UP
        DOWN
        LEFT
        RIGHT
    }

    enum CharacterState {
        IDLE
        WALKING
        ATTACKING
        HIT
        DEAD
    }

    Character <|-- Player
    Character <|-- Enemy
    CharacterPrototype <|.. Enemy
    Player "1" *-- "1" Backpack : contains
    Player "1" o-- "0..1" SpecialAbility : uses
    Enemy "1" o-- "0..1" SpecialAbility : uses
    Backpack "1" o-- "0..*" Collectible : contains
    GameModel "1" *-- "1" GameState : maintains
    GameModel "1" o-- "0..2" Player : has
    GameState "1" *-- "0..2" PlayerSaveState : contains
    CharacterSelectionModel "1" *-- "0..*" CharacterSelectionOption : contains
}

package io.github.iss_2025_2026.model.abilities {
    interface AbilityStrategy {
        + execute(context: AbilityContext): void
    }
    class DataDrivenAbility implements io.github.iss_2025_2026.model.SpecialAbility {
        - id: String
        - name: String
        - description: String
        - strategy: AbilityStrategy
    }
    class AbilityConfiguration {
        - id: String
        - name: String
        - description: String
        - strategyType: String
        - parameters: Map<String, Object>
    }
    class AbilityContext {
        - source: Character
        - target: Character
        - level: int
        - parameters: Map<String, Object>
        + AbilityContext(source: Character, target: Character, level: int, parameters: Map<String, Object>)
    }
    class AbilityFactory {
        + {static} createAbility(config: AbilityConfiguration): SpecialAbility
    }
    class AbilityLoader {
        + {static} loadAbilities(directoryPath: String): List<AbilityConfiguration>
    }
}

package io.github.iss_2025_2026.model.abilities.strategies {
    class DamageStrategy implements io.github.iss_2025_2026.model.abilities.AbilityStrategy {
        + execute(context: AbilityContext): void
    }
    class HealStrategy implements io.github.iss_2025_2026.model.abilities.AbilityStrategy {
        + execute(context: AbilityContext): void
    }
}

package io.github.iss_2025_2026.model.collectibles {
    interface CollectibleEffectStrategy {
        + apply(context: CollectibleUseContext): void
    }
    class CollectibleUseContext {
        - user: Character
        - target: Character
        - gameModel: GameModel
        + CollectibleUseContext(user: Character, target: Character, gameModel: GameModel)
    }
    class CollectibleEffectFactory {
        + {static} getStrategy(effectType: String, parameters: Map<String, Object>): CollectibleEffectStrategy
    }
}

package io.github.iss_2025_2026.model.collectibles.strategies {
    class BuffCollectibleStrategy implements io.github.iss_2025_2026.model.collectibles.CollectibleEffectStrategy {
        + apply(context: CollectibleUseContext): void
    }
    class DamageCollectibleStrategy implements io.github.iss_2025_2026.model.collectibles.CollectibleEffectStrategy {
        + apply(context: CollectibleUseContext): void
    }
    class HealCollectibleStrategy implements io.github.iss_2025_2026.model.collectibles.CollectibleEffectStrategy {
        + apply(context: CollectibleUseContext): void
    }
}

package io.github.iss_2025_2026.model.combat {
    class BattleModel {
        - playerOne: Player
        - playerTwo: Player
        - enemies: List<Enemy>
        - combatants: List<Character>
        - currentTurnIndex: int
        - phase: BattlePhase
        + BattleModel(p1: Player, p2: Player, enemies: List<Enemy>)
        + nextTurn(): void
    }
    enum BattlePhase {
        START
        PLAYER_TURN
        ENEMY_TURN
        VICTORY
        DEFEAT
    }
}

Collectible o-- CollectibleEffectStrategy : delegates to
@enduml
