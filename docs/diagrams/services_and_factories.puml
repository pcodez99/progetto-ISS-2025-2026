@startuml services_and_factories
package io.github.iss_2025_2026.factory {

    interface CharacterFactory {
        + createPlayer(id: String): Player
        + createEnemy(id: String): Enemy
        + getAbility(abilityId: String): SpecialAbility
        + getCharacterData(): Map<String, Map<String, Object>>
        + getEnemyData(): Map<String, Map<String, Object>>
    }

    class YamlCharacterFactory implements CharacterFactory {
        - playersData: Map<String, Map<String, Object>>
        - enemiesData: Map<String, Map<String, Object>>
        - abilityRegistry: AbilityRegistry
        + YamlCharacterFactory()
        + createPlayer(id: String): Player
        + createEnemy(id: String): Enemy
        + getAbility(abilityId: String): SpecialAbility
    }

    class AbilityRegistry {
        - registry: Map<String, SpecialAbility>
        + AbilityRegistry()
        + getAbility(id: String): SpecialAbility
    }

    class CharacterConfigLoader {
        + {static} loadYaml(filepath: String): Map<String, Map<String, Object>>
    }

    class CharacterTypeFactory {
        + {static} createCharacter(type: String): Character
    }

    class CollectibleFactory {
        + {static} createCollectible(id: String): Collectible
    }

    class NpcFactory {
        - npcCatalog: Map<String, Npc>
        + NpcFactory()
        + getNpc(id: String): Npc
        + findNpc(id: String): Optional<Npc>
        + requireNpc(id: String): Npc
        + getAllNpcs(): List<Npc>
        + getNpcsForLevel(levelId: String): List<Npc>
    }

    class EvolutionRuleFactory {
        - rulesByCharacterId: Map<String, CharacterEvolutionRules>
        + EvolutionRuleFactory()
        + getRulesForCharacter(characterId: String): CharacterEvolutionRules
    }

    class DialogueProfileFactory {
        - profiles: Map<EvolutionPath, DialogueProfile>
        + DialogueProfileFactory()
        + getProfile(path: EvolutionPath): DialogueProfile
    }

    class EnemyFactory {
        + {static} createEnemy(id: String): Enemy
    }

    class PlayerFactory {
        + {static} createPlayer(id: String): Player
    }

    class EnemyBuilder {
        - id: String
        - name: String
        - maxHp: int
        - baseDamage: int
        - xpReward: int
        - boss: boolean
        - specialAbility: SpecialAbility
        + EnemyBuilder()
        + build(): Enemy
    }

    class PlayerBuilder {
        - id: String
        - name: String
        - maxHp: int
        - baseDamage: int
        - maxHpGrowth: int
        - damageGrowth: int
        - level: int
        - karma: int
        - backpack: Backpack
        - ability: SpecialAbility
        + PlayerBuilder()
        + build(): Player
    }
}

package io.github.iss_2025_2026.map {
    class TmxLevelLoader {
        + loadLevel(levelId: int): TmxLevel
    }

    class TmxLevel {
        - map: TiledMap
        - geometry: IsoMapGeometry
        + TmxLevel(map: TiledMap)
        + getMap(): TiledMap
        + getGeometry(): IsoMapGeometry
    }

    class CheckpointDefinition {
        - id: String
        - levelId: int
        - bounds: Rectangle
        + CheckpointDefinition(id: String, levelId: int, bounds: Rectangle)
    }

    class GameStartupValidator {
        + {static} validateRuntimeAssets(): LevelValidationResult
    }

    class IsoMapGeometry {
        - bounds: Rectangle
        - obstacleLayers: List<MapLayer>
        + IsoMapGeometry(map: TiledMap)
    }

    interface LevelAssetResolver {
        + resolve(path: String): FileHandle
    }

    class LevelAssetResolvers {
        + {static} defaultResolver(): LevelAssetResolver
    }

    class LevelAssetValidator {
        + {static} validate(level: LevelDefinition): LevelValidationResult
    }

    class LevelCatalog {
        - catalog: Map<Integer, LevelDefinition>
        + LevelCatalog()
        + getLevel(id: int): LevelDefinition
    }

    class LevelDefinition {
        - id: int
        - tmxPath: String
        - name: String
        + LevelDefinition(id: int, tmxPath: String, name: String)
    }

    class LevelManifest {
        - levels: List<LevelDefinition>
        + LevelManifest()
    }

    class LevelRuntime {
        - level: TmxLevel
        - levelId: int
        + LevelRuntime(level: TmxLevel, levelId: int)
    }

    class LevelValidationResult {
        - valid: boolean
        - errors: List<String>
        + LevelValidationResult(valid: boolean, errors: List<String>)
        + isValid(): boolean
        + toUserMessage(): String
    }

    class MapPhysicsBuilder {
        + {static} buildMapPhysics(level: TmxLevel, world: World): void
    }

    class TmxMapContract {
        + {static} OBSTACLES_LAYER: String
    }
}

package io.github.iss_2025_2026.physics {
    class PhysicsFacade {
        - world: World
        - bodies: Map<Character, Body>
        + PhysicsFacade(level: TmxLevel, playerSize: float, playerYOffset: float)
        + initPlayerBody(player: Player): void
        + setPlayerVelocity(player: Player, delta: float): void
        + step(delta: float): void
        + syncPlayerPositions(): void
        + drawDebug(cam: OrthographicCamera): void
        + dispose(): void
    }
}

package io.github.iss_2025_2026.persistence {
    class SaveManager {
        - saveDirectory: File
        + SaveManager()
        + saveGame(state: GameState, filename: String): void
        + loadGame(filename: String): GameState
        + listSaveFiles(): List<String>
    }
}

package io.github.iss_2025_2026.service {
    class EvolutionService {
        - ruleFactory: EvolutionRuleFactory
        + applyChoice(player: Player, event: PlayerChoiceEvent): EvolutionResult
        + applyNpcChoice(player: Player, npc: Npc, type: ChoiceEventType): EvolutionResult
    }

    class DialogueProfileService {
        - profileFactory: DialogueProfileFactory
        + buildPrompt(player: Player, npc: Npc): DialoguePrompt
    }

    class NpcDialogueService {
        - dialogueProfileService: DialogueProfileService
        + getDialogues(player: Player, npc: Npc): List<String>
        + getDialogues(player: Player, npc: Npc, history: List<String>): List<String>
        + getOpeningDialogue(player: Player, npc: Npc): String
        + getReactionDialogue(player: Player, npc: Npc, choiceType: ChoiceEventType): String
    }

    class CheckpointService {
        - model: GameModel
        - levelRuntime: LevelRuntime
        + CheckpointService(model: GameModel, levelRuntime: LevelRuntime)
        + pollCheckpointReachedEvent(): SaveResult
    }

    class EnemyEncounter {
        - enemies: List<Enemy>
        + EnemyEncounter(enemies: List<Enemy>)
        + getEnemies(): List<Enemy>
    }

    class EnemyEncounterService {
        - enemySpawnPoints: List<EnemySpawnPoint>
        - factory: CharacterFactory
        - geometry: IsoMapGeometry
        - encounterRadius: float
        + EnemyEncounterService(enemySpawnPoints: List<EnemySpawnPoint>, factory: CharacterFactory, geometry: IsoMapGeometry, encounterRadius: float)
        + checkEncounter(player: Player): EnemyEncounter
    }

    class GameOverResult {
        - status: Status
        - message: String
        + GameOverResult(status: Status, message: String)
    }

    class GameOverService {
        - saveManager: SaveManager
        + GameOverService(saveManager: SaveManager)
        + restoreFromLastSave(model: GameModel): GameOverResult
    }

    class GameProperties {
        - {static} properties: Properties
        + {static} get(key: String, fallback: String): String
        + {static} getInt(key: String, fallback: int): int
        + {static} getFloat(key: String, fallback: float): float
        + {static} getBoolean(key: String, fallback: boolean): boolean
    }

    class GameSaveService {
        - saveManager: SaveManager
        + GameSaveService(saveManager: SaveManager)
        + save(model: GameModel, type: SaveType): SaveResult
    }

    class MenuMusicManager {
        + {static} play(): void
        + {static} pause(): void
        + {static} stop(): void
        + {static} setVolume(vol: float): void
    }

    class RunMusicManager {
        + {static} play(): void
        + {static} pause(): void
        + {static} stop(): void
        + {static} setVolume(vol: float): void
    }

    class SaveResult {
        - status: Status
        - message: String
        + SaveResult(status: Status, message: String)
        + shouldNotifyPlayer(): boolean
    }

    class SaveValidator {
        + {static} validate(state: GameState): boolean
    }

    class SettingsManager {
        - {static} SETTINGS_FILE: String
        + {static} loadSettings(): GameSettings
        + {static} saveSettings(settings: GameSettings): void
    }
}

package io.github.iss_2025_2026.service.ai {
    class AiService {
        - {static} ai: AiService
        - config: AiConfig
        - client: AiClient
        + {static} getAi(): AiService
        + {static} setAi(replacement: AiService): void
        + {static} resetAi(): void
        + chat(request: AiRequest): AiResponse
    }

    class AiConfig {
        - baseUrl: String
        - model: String
        - chatEndpoint: String
        - defaultTemperature: float
        + {static} fromGameProperties(): AiConfig
        + getChatUrl(): String
    }

    interface AiClient {
        + chat(request: AiRequest, config: AiConfig): AiResponse
        + isAvailable(config: AiConfig): boolean
    }

    class OllamaAiClient implements AiClient {
        + chat(request: AiRequest, config: AiConfig): AiResponse
        + isAvailable(config: AiConfig): boolean
    }

    class AiRequest {
        - model: String
        - messages: List<AiMessage>
        - temperature: Float
        + withDefaults(config: AiConfig): AiRequest
    }

    class AiResponse {
        - content: String
        - model: String
        - rawResponse: String
    }
}

YamlCharacterFactory o-- AbilityRegistry : uses
EnemyEncounterService o-- io.github.iss_2025_2026.factory.CharacterFactory : uses
CheckpointService o-- io.github.iss_2025_2026.model.GameModel : uses
GameOverService o-- io.github.iss_2025_2026.persistence.SaveManager : uses
GameSaveService o-- io.github.iss_2025_2026.persistence.SaveManager : uses
NpcDialogueService o-- DialogueProfileService : uses
NpcDialogueService o-- io.github.iss_2025_2026.service.ai.AiService : uses
AiService o-- io.github.iss_2025_2026.service.ai.AiClient : delegates to
AiService o-- io.github.iss_2025_2026.service.ai.AiConfig : configured by
@enduml
